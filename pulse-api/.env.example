# Community edition. Copy to .env and fill your own values.
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/sigmaseller
API_KEY=
JWT_SECRET=
API_KEY_ENCRYPTION_SECRET=
# Generate each secret separately, e.g. openssl rand -hex 32
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
CORS_ORIGIN=http://localhost:3001
FRONTEND_URL=http://localhost:3001
LOCAL_STORAGE_URL=http://localhost:3000/storage
REDIS_URL=redis://127.0.0.1:6379
REGISTRATION_DISABLED=0
DISABLE_INTERNAL_JOBS=0
ENABLE_MULTI_AGENT=0
ENABLE_ACTION_QUEUE=0
ENABLE_FINANCE_DAILY_SYNC=1
ENABLE_ADV_DAILY_SYNC=1
ENABLE_ORDERS_SALES_SYNC=1
ENABLE_SPP_DAILY_SYNC=1
ENABLE_FUNNEL_DAILY_SYNC=1
COMMUNITY_READ_ONLY_AUTOMATIONS=1
# Child-process concurrency per API/worker. Keep 1 on small shared servers.
WB_SYNC_CONCURRENCY=1
# A cloud WB partner agreement can carry charges. No partner secret by default.
# Set to 1 when the operator accepts paying WB API charges for connected stores.
WB_PARTNER_BILLING_ACCEPTED=0
# WB_PARTNER_BILLING_VERIFIED_FREE=1 is only for a confirmed free WB agreement.
# Optional free Telegram integration: TELEGRAM_BOT_TOKEN, TELEGRAM_BOT_USERNAME.
# Seller AI keys belong in /settings/ai, never here.
# Shared AI keys, Resend, external S3 credentials and paid telemetry are rejected.

# MCP public origin; in production use the real HTTPS origin, with no path.
MCP_PUBLIC_ORIGIN=http://localhost:3001
MCP_CLIENT_REDIRECT_HOSTS=chatgpt.com,claude.ai,claude.com
MCP_WB_WRITES_ENABLED=0
